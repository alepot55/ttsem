namespace Discovery.FP.SoftmaxOnline

open Discovery Discovery.Library.SoftmaxOnline

/-- Pass `a` on one block `A`, in floating point: `st` is one possible summary,
every in-block sum along a tree of depth at most `D`. -/
def fblock_a (F : Discovery.Rounding) (D : ℕ) (A : List (ℝ)) (st : State_a) : Prop :=
  ∃ v_m v_d r1 r2,
    r1 = lmax A ∧
    v_m = r1 ∧
    Discovery.fsum F D (fun x y => ∃ q1 q2, F.add (x - v_m) q1 ∧ F.exp q1 q2 ∧ y = q2) A r2 ∧
    v_d = r2 ∧
    st = ⟨v_m, v_d⟩

/-- Pass `a`, two adjacent float summaries `L` then `R` merged in floating
point: `st` is one possible result. -/
def fmerge_a (F : Discovery.Rounding) (L R st : State_a) : Prop :=
  ∃ v_m v_d r1 r2 r3 r4 r5 r6 r7,
    v_m = (max L.m R.m) ∧
    F.add (L.m - v_m) r1 ∧
    F.exp r1 r2 ∧
    F.mul (L.d * r2) r3 ∧
    F.add (R.m - v_m) r4 ∧
    F.exp r4 r5 ∧
    F.mul (R.d * r5) r6 ∧
    F.add (r3 + r6) r7 ∧
    v_d = r7 ∧
    st = ⟨v_m, v_d⟩

/-- The normalizer a state encodes: one over the output expression read at the element `0`. -/
noncomputable def znorm (st : State_a) : ℝ := 1 / ((Real.exp ((0 : ℝ) - st.m)) / st.d)

/-- The rounding is small: float32, float16 and bfloat16 all satisfy this. -/
def small (F : Discovery.Rounding) : Prop := F.u ≤ 1 / 256 ∧ F.ue ≤ 1 / 64 ∧ F.ul ≤ 1 / 64 ∧ F.η ≤ 1 / 2 ^ 100 ∧ F.ηe ≤ 1 / 2 ^ 100

/-! ## The statement, fixed before any proof text -/

def fp_bound_statement : Prop :=
