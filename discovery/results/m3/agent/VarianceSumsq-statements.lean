import Discovery.Approx
import Discovery.Library.VarianceSumsq

/-!
# `variance-sumsq` in floating point

Generated by `discovery/fp_export.py` (statement version 3) from the program below
(digest ae2513dfa2a3a1de).

```
(program variance-sumsq
  (input x)
  (pass a
    (state n t u)
    (block (n (sum 1))
           (t (sum x))
           (u (sum (* x x))))
    (merge (n (+ L.n R.n))
           (t (+ L.t R.t))
           (u (+ L.u R.u))))
  (output final (mean (/ a.t a.n)) (var (- (/ a.u a.n) (* (/ a.t a.n) (/ a.t a.n))))))
```
-/

namespace Discovery.FP.VarianceSumsq

open Discovery Discovery.Library.VarianceSumsq

/-- Pass `a` on one block `A`, in floating point: `st` is one possible summary,
every in-block sum along a tree of depth at most `D`. -/
def fblock_a (F : Discovery.Rounding) (D : ℕ) (A : List (ℝ)) (st : State_a) : Prop :=
  ∃ v_n v_t v_u r1 r2 r3,
    r1 = (A.length : ℝ) ∧
    v_n = r1 ∧
    Discovery.fsum F D (fun x y => y = x) A r2 ∧
    v_t = r2 ∧
    Discovery.fsum F D (fun x y => ∃ q1, F.mul (x * x) q1 ∧ y = q1) A r3 ∧
    v_u = r3 ∧
    st = ⟨v_n, v_t, v_u⟩

/-- Pass `a`, two adjacent float summaries `L` then `R` merged in floating
point: `st` is one possible result. -/
def fmerge_a (F : Discovery.Rounding) (L R st : State_a) : Prop :=
  ∃ v_n v_t v_u r1 r2,
    v_n = L.n + R.n ∧
    F.add (L.t + R.t) r1 ∧
    v_t = r1 ∧
    F.add (L.u + R.u) r2 ∧
    v_u = r2 ∧
    st = ⟨v_n, v_t, v_u⟩

/-- The output `var`, rounded as its expression rounds it: `w` is one possible
value. -/
def fout_var (F : Discovery.Rounding) (st : State_a) (w : ℝ) : Prop :=
  ∃ r1 r2 r3 r4 r5,
    F.mul (st.u / st.n) r1 ∧
    F.mul (st.t / st.n) r2 ∧
    F.mul (st.t / st.n) r3 ∧
    F.mul (r2 * r3) r4 ∧
    F.add (r1 - r4) r5 ∧
    w = r5

/-- The exact (population) variance of a row. -/
noncomputable def vr (X : List ℝ) : ℝ :=
  (X.map fun x => (x - X.sum / X.length) ^ 2).sum / X.length

/-- The exact mean of the squares of a row. -/
noncomputable def msq (X : List ℝ) : ℝ := (X.map fun x => x ^ 2).sum / X.length

/-- The rounding is small: float32, float16 and bfloat16 all satisfy this. -/
def small (F : Discovery.Rounding) : Prop := F.u ≤ 1 / 256 ∧ F.ue ≤ 1 / 64 ∧ F.ul ≤ 1 / 64 ∧ F.η ≤ 1 / 2 ^ 100 ∧ F.ηe ≤ 1 / 2 ^ 100

/-! ## The statement, fixed before any proof text -/

def fp_bound_statement : Prop :=
  ∀ (F : Discovery.Rounding) (D : ℕ) (lo hi : ℝ) (X : List (ℝ)), X ≠ [] →
    (∀ x ∈ X, lo ≤ x ∧ x ≤ hi) → small F → (X.length : ℝ) * (F.η + F.ηe) ≤ F.u → (X.length : ℝ) * F.u ≤ 1 →
    ∀ (t : Discovery.Tree (ℝ)), t.flat = X → (∀ b ∈ t.leaves, b ≠ []) →
    ((t.depth : ℝ) + D + 1) * (F.u + F.ue + F.ul) ≤ 1 / 16 →
    ∀ (st : State_a), Discovery.Tree.FEval (fblock_a F D) (fmerge_a F) t st →
    ∀ (w : ℝ), fout_var F st w →
      |w - vr X| ≤ (((4 : ℝ) * ((D : ℝ) + (t.depth : ℝ) + (3 : ℝ)) * F.u * (msq X)) + ((6 : ℝ) * F.η))

end Discovery.FP.VarianceSumsq
