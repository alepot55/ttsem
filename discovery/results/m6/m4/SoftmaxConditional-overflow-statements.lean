import Discovery.Approx

/-!
# `softmax-conditional` in floating point

Generated by `discovery/fp_export.py` (statement version 4) from the program below
(digest 22b9e62bd90b4fd1).

```
(program softmax-conditional
  (input x)
  (param tau 8)
  (pass a
    (state m d)
    (block (m (rmax x))
           (d (sum (exp (- x m)))))
    (merge (m (ifgt (- R.m L.m) tau R.m L.m))
           (d (+ (* L.d (exp (- L.m m))) (* R.d (exp (- R.m m)))))))
  (output elementwise (/ (exp (- x a.m)) a.d)))
```
-/

namespace Discovery.FP.SoftmaxConditionalOverflow

open Discovery

/-- The state of pass `a`. -/
@[ext] structure State_a where
  m : ℝ
  d : ℝ

/-- Pass `a` on one block, exactly. -/
noncomputable def block_a (tau : ℝ) (A : List ℝ) : State_a :=
  let b_m := (lmax A)
  let b_d := ((A.map fun x => (Real.exp (x - b_m))).sum)
  ⟨b_m, b_d⟩

/-- Pass `a`, two adjacent summaries merged, exactly. -/
noncomputable def merge_a (tau : ℝ) (L R : State_a) : State_a :=
  let b_m := (if (R.m - L.m) > tau then R.m else L.m)
  let b_d := ((L.d * (Real.exp (L.m - b_m))) + (R.d * (Real.exp (R.m - b_m))))
  ⟨b_m, b_d⟩

/-- The right depth of a merge tree: a leaf `0`, a node `max (left) (right + 1)`. -/
def rdepth {E : Type*} : Discovery.Tree E → ℕ
  | .leaf _ => 0
  | .node l r => max (rdepth l) (rdepth r + 1)

/-- Pass `a` on one block `A`, in floating point: `st` is one possible summary,
every in-block sum along a tree of depth at most `D`. -/
def fblock_a (F : Discovery.Rounding) (D : ℕ) (tau : ℝ) (A : List (ℝ)) (st : State_a) : Prop :=
  ∃ v_m v_d r1 r2,
    r1 = lmax A ∧
    v_m = r1 ∧
    Discovery.fsum F D (fun x y => ∃ q1 q2, F.add (x - v_m) q1 ∧ F.exp q1 q2 ∧ y = q2) A r2 ∧
    v_d = r2 ∧
    st = ⟨v_m, v_d⟩

/-- Pass `a`, two adjacent float summaries `L` then `R` merged in floating
point: `st` is one possible result. -/
def fmerge_a (F : Discovery.Rounding) (tau : ℝ) (L R st : State_a) : Prop :=
  ∃ v_m v_d r1 r2 r3 r4 r5 r6 r7 r8,
    F.add (R.m - L.m) r1 ∧
    v_m = (if r1 > tau then R.m else L.m) ∧
    F.add (L.m - v_m) r2 ∧
    F.exp r2 r3 ∧
    F.mul (L.d * r3) r4 ∧
    F.add (R.m - v_m) r5 ∧
    F.exp r5 r6 ∧
    F.mul (R.d * r6) r7 ∧
    F.add (r4 + r7) r8 ∧
    v_d = r8 ∧
    st = ⟨v_m, v_d⟩

/-- The normalizer a state encodes: one over the output expression read at the element `0`. -/
noncomputable def znorm (st : State_a) : ℝ := 1 / ((Real.exp ((0 : ℝ) - st.m)) / st.d)

/-- The rounding is small: float32 and bfloat16 satisfy this; float16 does not (η = 2⁻²⁵). -/
def small (F : Discovery.Rounding) : Prop := F.u ≤ 1 / 256 ∧ F.ue ≤ 1 / 64 ∧ F.ul ≤ 1 / 64 ∧ F.η ≤ 1 / 2 ^ 100 ∧ F.ηe ≤ 1 / 2 ^ 100

/-! ## The statement, fixed before any proof text -/

def fp_bound_statement : Prop :=
  ∀ (tau : ℝ), 0 ≤ tau → 
  ∀ (X : List ℝ), X ≠ [] → ∀ (t : Discovery.Tree ℝ), t.flat = X →
    (∀ b ∈ t.leaves, b ≠ []) →
      (t.eval (block_a tau) (merge_a tau)).d ≤ (X.length : ℝ) * Real.exp (tau * (rdepth t : ℝ))

end Discovery.FP.SoftmaxConditionalOverflow
