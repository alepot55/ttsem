import Discovery.Blocked
import Mathlib.Algebra.BigOperators.Ring.List
import Mathlib.Algebra.Module.BigOperators
import Mathlib.Analysis.Complex.Exponential
import Mathlib.Analysis.Real.Sqrt
import Mathlib.Analysis.SpecialFunctions.Log.Basic
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Module
import Mathlib.Tactic.Positivity
import Mathlib.Tactic.Ring

/-!
# `variance-welford` against `variance-2pass`

Generated by `discovery/lean_export.py` from the program below (digest babb67f94322eed7).

```
(program variance-welford
  (input x)
  (pass a
    (state n mu q)
    (block (n (sum 1))
           (mu (/ (sum x) n))
           (q (sum (* (- x mu) (- x mu)))))
    (merge (n (+ L.n R.n))
           (mu (+ L.mu (* (- R.mu L.mu) (/ R.n n))))
           (q (+ L.q R.q (* (- R.mu L.mu) (- R.mu L.mu) (/ (* L.n R.n) n))))))
  (output final (mean a.mu) (var (/ a.q a.n))))
```
-/

namespace Discovery.Library.VarianceWelford

/-- The named outputs. -/
@[ext] structure Out where
  mean : ℝ
  var : ℝ

/-! ## The candidate -/

/-- The state of pass `a`. -/
@[ext] structure State_a where
  n : ℝ
  mu : ℝ
  q : ℝ

/-- Pass `a` on one block `A`: (n (sum 1)) (mu (/ (sum x) n)) (q (sum (* (- x mu) (- x mu)))) -/
noncomputable def block_a (A : List ℝ) : State_a :=
  { n := (A.map fun _ => (1 : ℝ)).sum,
    mu := A.sum / (A.map fun _ => (1 : ℝ)).sum,
    q := (A.map fun x => (x - A.sum / (A.map fun _ => (1 : ℝ)).sum) * (x - A.sum / (A.map fun _ => (1 : ℝ)).sum)).sum }

/-- Pass `a`, two adjacent summaries `L` then `R` into one: (n (+ L.n R.n)) (mu (+ L.mu (* (- R.mu L.mu) (/ R.n n)))) (q (+ L.q R.q (* (- R.mu L.mu) (- R.mu L.mu) (/ (* L.n R.n) n)))) -/
noncomputable def merge_a (L R : State_a) : State_a :=
  { n := L.n + R.n,
    mu := L.mu + (R.mu - L.mu) * (R.n / (L.n + R.n)),
    q := L.q + R.q + (R.mu - L.mu) * (R.mu - L.mu) * (L.n * R.n / (L.n + R.n)) }

/-- The candidate's output, every pass reading all of `X` as one block. -/
noncomputable def output (X : List ℝ) : Out :=
  let a := block_a X
  { mean := a.mu,
    var := a.q / a.n }

/-- The candidate as a kernel runs it: every pass summarises the leaves of its own merge tree and merges the summaries along the tree. -/
noncomputable def blocked (t_a : Discovery.Tree ℝ) : Out :=
  let a := t_a.eval block_a merge_a
  { mean := a.mu,
    var := a.q / a.n }

/-! ## The specification: `variance-2pass`, every pass reading all of `X` as one block -/

namespace Spec

/-- The state of pass `a`. -/
@[ext] structure State_a where
  n : ℝ
  t : ℝ

/-- Pass `a` on one block `A`: (n (sum 1)) (t (sum x)) -/
noncomputable def block_a (A : List ℝ) : State_a :=
  { n := (A.map fun _ => (1 : ℝ)).sum,
    t := A.sum }

/-- The state of pass `b`. -/
@[ext] structure State_b where
  q : ℝ

/-- Pass `b` on one block `A`: (q (sum (* (- x (/ a.t a.n)) (- x (/ a.t a.n))))) -/
noncomputable def block_b (a : State_a) (A : List ℝ) : State_b :=
  { q := (A.map fun x => (x - a.t / a.n) * (x - a.t / a.n)).sum }

/-- The specification's output. -/
noncomputable def output (X : List ℝ) : Out :=
  let a := block_a X
  let b := block_b a X
  { mean := a.t / a.n,
    var := b.q / a.n }

end Spec

/-! ## The statements, fixed before any proof text -/

def merge_block_a_statement : Prop :=
  ∀ (A B : List ℝ), A ≠ [] → B ≠ [] →
    merge_a (block_a A) (block_a B) = block_a (A ++ B)

def spec_eq_statement : Prop :=
  ∀ (X : List ℝ), X ≠ [] →
    output X = Spec.output X

def blocked_eq_spec_statement : Prop :=
  ∀ (X : List ℝ), X ≠ [] → ∀ (t_a : Discovery.Tree ℝ), t_a.flat = X → (∀ blk ∈ t_a.leaves, blk ≠ []) →
    blocked t_a = Spec.output X

/-! ## The proofs -/

-- helper lemmas
theorem one_sum (A : List ℝ) : (A.map fun _ => (1 : ℝ)).sum = A.length := by simp

theorem q_expand (A : List ℝ) (c : ℝ) :
    (A.map fun x => (x - c) * (x - c)).sum
      = (A.map fun x => x * x).sum - 2 * c * A.sum + c * c * A.length := by
  induction A with
  | nil => simp
  | cons y ys ih =>
    simp only [List.map_cons, List.sum_cons, List.length_cons, ih]
    push_cast
    ring

/-- Pass `a`: merging the summaries of two nonempty blocks gives the summary of the two blocks together. -/
theorem merge_block_a (A B : List ℝ) (hA : A ≠ []) (hB : B ≠ []) :
    merge_a (block_a A) (block_a B) = block_a (A ++ B) := by
  have ha : (0:ℝ) < A.length := by exact_mod_cast List.length_pos_iff.mpr hA
  have hb : (0:ℝ) < B.length := by exact_mod_cast List.length_pos_iff.mpr hB
  have ha' : (A.length:ℝ) ≠ 0 := ha.ne'
  have hb' : (B.length:ℝ) ≠ 0 := hb.ne'
  have hab : (A.length:ℝ) + B.length ≠ 0 := by positivity
  ext <;> simp only [merge_a, block_a, one_sum, q_expand, List.map_append, List.sum_append, List.length_append, Nat.cast_add] <;> (field_simp <;> ring)

/-- On one nonempty block, the candidate's output equals the specification's (`variance-2pass`). -/
theorem spec_eq (X : List ℝ) (hX : X ≠ []) :
    output X = Spec.output X := by
  first
    | rfl
    | (ext <;> simp only [output, Spec.output, block_a, Spec.block_a, Spec.block_b])

/-- Over any blocking and any merge trees, the candidate computes the specification: the framework theorem for every pass, then `spec_eq`. -/
theorem blocked_eq_spec (X : List ℝ) (hX : X ≠ []) (t_a : Discovery.Tree ℝ) (h_a : t_a.flat = X) (l_a : ∀ blk ∈ t_a.leaves, blk ≠ []) :
    blocked t_a = Spec.output X := by
  have e_0 : t_a.eval block_a merge_a = block_a X := by
    rw [Discovery.Tree.eval_eq_block merge_block_a t_a l_a, h_a]
  rw [← spec_eq X hX]
  simp only [blocked, output, e_0]

/-! ## Checks: every theorem against its statement fixed above, and its axioms -/

theorem merge_block_a_holds : merge_block_a_statement := merge_block_a
theorem spec_eq_holds : spec_eq_statement := spec_eq
theorem blocked_eq_spec_holds : blocked_eq_spec_statement := blocked_eq_spec

#print axioms merge_block_a_holds
#print axioms spec_eq_holds
#print axioms blocked_eq_spec_holds

end Discovery.Library.VarianceWelford
