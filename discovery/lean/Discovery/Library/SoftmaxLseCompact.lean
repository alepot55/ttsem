/-!
# `softmax-lse-compact` against `softmax-3pass`

Generated by `discovery/lean_export.py` from the program below (digest b4d0afe0ef7483d5).

```
(program softmax-lse-compact
  (input x)
  (pass a
    (state l)
    (block (mm (rmax x))
           (l (+ mm (log (sum (exp (- x mm)))))))
    (merge (l (+ (max L.l R.l) (log (+ 1 (exp (neg (abs (- L.l R.l))))))))))
  (output elementwise (exp (- x a.l))))
```
-/

namespace Discovery.Library.SoftmaxLseCompact

/-! ## The candidate -/

/-- The state of pass `a`. -/
@[ext] structure State_a where
  l : ℝ

/-- Pass `a` on one block `A`: (mm (rmax x)) (l (+ mm (log (sum (exp (- x mm)))))) -/
noncomputable def block_a (A : List ℝ) : State_a :=
  { l := lmax A + Real.log (A.map fun x => Real.exp (x - lmax A)).sum }

/-- Pass `a`, two adjacent summaries `L` then `R` into one: (l (+ (max L.l R.l) (log (+ 1 (exp (neg (abs (- L.l R.l)))))))) -/
noncomputable def merge_a (L R : State_a) : State_a :=
  { l := max L.l R.l + Real.log ((1 : ℝ) + Real.exp (-|L.l - R.l|)) }

/-- The candidate's output, every pass reading all of `X` as one block. -/
noncomputable def output (X : List ℝ) (x : ℝ) : ℝ :=
  let a := block_a X
  Real.exp (x - a.l)

/-- The candidate as a kernel runs it: every pass summarises the leaves of its own merge tree and merges the summaries along the tree. -/
noncomputable def blocked (t_a : Discovery.Tree ℝ) (x : ℝ) : ℝ :=
  let a := t_a.eval block_a merge_a
  Real.exp (x - a.l)

/-! ## The specification: `softmax-3pass`, every pass reading all of `X` as one block -/

namespace Spec

/-- The state of pass `a`. -/
@[ext] structure State_a where
  m : ℝ

/-- Pass `a` on one block `A`: (m (rmax x)) -/
noncomputable def block_a (A : List ℝ) : State_a :=
  { m := lmax A }

/-- The state of pass `b`. -/
@[ext] structure State_b where
  d : ℝ

/-- Pass `b` on one block `A`: (d (sum (exp (- x a.m)))) -/
noncomputable def block_b (a : State_a) (A : List ℝ) : State_b :=
  { d := (A.map fun x => Real.exp (x - a.m)).sum }

/-- The specification's output. -/
noncomputable def output (X : List ℝ) (x : ℝ) : ℝ :=
  let a := block_a X
  let b := block_b a X
  Real.exp (x - a.m) / b.d

end Spec

/-! ## The statements, fixed before any proof text -/

def merge_block_a_statement : Prop :=
  ∀ (A B : List ℝ), A ≠ [] → B ≠ [] →
    merge_a (block_a A) (block_a B) = block_a (A ++ B)

def spec_eq_statement : Prop :=
  ∀ (X : List ℝ), X ≠ [] → ∀ (x : ℝ),
    output X x = Spec.output X x

def blocked_eq_spec_statement : Prop :=
  ∀ (X : List ℝ), X ≠ [] → ∀ (t_a : Discovery.Tree ℝ), t_a.flat = X → (∀ blk ∈ t_a.leaves, blk ≠ []) → ∀ (x : ℝ),
    blocked t_a x = Spec.output X x

/-! ## The proofs -/

-- helper lemmas
theorem nonneg_sum_exp (A : List ℝ) (c : ℝ) :
    0 ≤ (A.map fun x => Real.exp (x - c)).sum := by
  induction A with
  | nil => simp
  | cons y ys ih =>
    simp only [List.map_cons, List.sum_cons]
    have := Real.exp_pos (y - c)
    linarith

theorem pos_sum_exp (A : List ℝ) (hA : A ≠ []) (c : ℝ) :
    0 < (A.map fun x => Real.exp (x - c)).sum := by
  cases A with
  | nil => exact absurd rfl hA
  | cons y ys =>
    simp only [List.map_cons, List.sum_cons]
    have := nonneg_sum_exp ys c
    have := Real.exp_pos (y - c)
    linarith

theorem exp_block_a (A : List ℝ) (hA : A ≠ []) :
    Real.exp (block_a A).l = (A.map Real.exp).sum := by
  have hS := pos_sum_exp A hA (lmax A)
  simp only [block_a]
  rw [Real.exp_add, Real.exp_log hS, ← List.sum_map_mul_left]
  congr 1
  apply List.map_congr_left
  intro x _
  rw [← Real.exp_add]
  congr 1
  ring

theorem max_log_lemma (a b : ℝ) :
    max a b + Real.log ((1 : ℝ) + Real.exp (-|a - b|)) = Real.log (Real.exp a + Real.exp b) := by
  rcases le_total a b with h | h
  · rw [max_eq_right h, abs_of_nonpos (by linarith : a - b ≤ 0), neg_neg]
    have h2 : Real.exp (a - b) * Real.exp b = Real.exp a := by
      rw [← Real.exp_add]; congr 1; ring
    have h3 : Real.exp a + Real.exp b = Real.exp b * (1 + Real.exp (a - b)) := by
      linear_combination (-1) * h2
    have hp : (1 + Real.exp (a - b)) ≠ 0 := by positivity
    rw [h3, Real.log_mul (Real.exp_ne_zero b) hp, Real.log_exp]
  · rw [max_eq_left h, abs_of_nonneg (sub_nonneg.2 h)]
    have e : -(a - b) = b - a := by ring
    rw [e]
    have h2 : Real.exp (b - a) * Real.exp a = Real.exp b := by
      rw [← Real.exp_add]; congr 1; ring
    have h3 : Real.exp a + Real.exp b = Real.exp a * (1 + Real.exp (b - a)) := by
      linear_combination (-1) * h2
    have hp : (1 + Real.exp (b - a)) ≠ 0 := by positivity
    rw [h3, Real.log_mul (Real.exp_ne_zero a) hp, Real.log_exp]

/-- Pass `a`: merging the summaries of two nonempty blocks gives the summary of the two blocks together. -/
theorem merge_block_a (A B : List ℝ) (hA : A ≠ []) (hB : B ≠ []) :
    merge_a (block_a A) (block_a B) = block_a (A ++ B) := by
  ext
  simp only [merge_a]
  have hAB : A ++ B ≠ [] := by simp [hA]
  rw [max_log_lemma, exp_block_a A hA, exp_block_a B hB]
  have h1 : (block_a (A ++ B)).l = Real.log (Real.exp (block_a (A ++ B)).l) := by
    rw [Real.log_exp]
  rw [h1, exp_block_a (A ++ B) hAB, List.map_append, List.sum_append]

/-- On one nonempty block, the candidate's output equals the specification's (`softmax-3pass`), for every element value. -/
theorem spec_eq (X : List ℝ) (hX : X ≠ []) (x : ℝ) :
    output X x = Spec.output X x := by
  have hS := pos_sum_exp X hX (lmax X)
  simp only [output, Spec.output, block_a, Spec.block_a, Spec.block_b]
  rw [← sub_sub, Real.exp_sub, Real.exp_log hS]

/-- Over any blocking and any merge trees, the candidate computes the specification: the framework theorem for every pass, then `spec_eq`. -/
theorem blocked_eq_spec (X : List ℝ) (hX : X ≠ []) (t_a : Discovery.Tree ℝ) (h_a : t_a.flat = X) (l_a : ∀ blk ∈ t_a.leaves, blk ≠ []) (x : ℝ) :
    blocked t_a x = Spec.output X x := by
  have e_0 : t_a.eval block_a merge_a = block_a X := by
    rw [Discovery.Tree.eval_eq_block merge_block_a t_a l_a, h_a]
  rw [← spec_eq X hX x]
  simp only [blocked, output, e_0]

/-! ## Checks: every theorem against its statement fixed above, and its axioms -/

theorem merge_block_a_holds : merge_block_a_statement := merge_block_a
theorem spec_eq_holds : spec_eq_statement := spec_eq
theorem blocked_eq_spec_holds : blocked_eq_spec_statement := blocked_eq_spec

#print axioms merge_block_a_holds
#print axioms spec_eq_holds
#print axioms blocked_eq_spec_holds

end Discovery.Library.SoftmaxLseCompact
