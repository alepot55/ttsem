import Discovery.Blocked
import Mathlib.Algebra.BigOperators.Ring.List
import Mathlib.Algebra.Module.BigOperators
import Mathlib.Analysis.Complex.Exponential
import Mathlib.Analysis.Real.Sqrt
import Mathlib.Analysis.SpecialFunctions.Log.Basic
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Module
import Mathlib.Tactic.Positivity
import Mathlib.Tactic.Ring

/-!
# `attention-online` against `attention-3pass`

Generated by `discovery/lean_export.py` from the program below (digest 981b077cbdfe4ce3).

```
(program attention-online
  (input s v)
  (pass a
    (state m d o)
    (block (m (rmax s))
           (d (sum (exp (- s m))))
           (o (sum (* (exp (- s m)) v))))
    (merge (m (max L.m R.m))
           (d (+ (* L.d (exp (- L.m m))) (* R.d (exp (- R.m m)))))
           (o (+ (* L.o (exp (- L.m m))) (* R.o (exp (- R.m m)))))))
  (output final (o (/ a.o a.d))))
```
-/

namespace Discovery.Library.AttentionOnline

variable {V : Type*} [AddCommGroup V] [Module ℝ V]

/-- The named outputs. -/
@[ext] structure Out (V : Type*) where
  o : V

/-! ## The candidate -/

/-- The state of pass `a`. -/
@[ext] structure State_a (V : Type*) where
  m : ℝ
  d : ℝ
  o : V

/-- Pass `a` on one block `A`: (m (rmax s)) (d (sum (exp (- s m)))) (o (sum (* (exp (- s m)) v))) -/
noncomputable def block_a (A : List (ℝ × V)) : State_a V :=
  { m := lmax (A.map fun e => e.1),
    d := (A.map fun e => Real.exp (e.1 - lmax (A.map fun e => e.1))).sum,
    o := (A.map fun e => Real.exp (e.1 - lmax (A.map fun e => e.1)) • e.2).sum }

/-- Pass `a`, two adjacent summaries `L` then `R` into one: (m (max L.m R.m)) (d (+ (* L.d (exp (- L.m m))) (* R.d (exp (- R.m m))))) (o (+ (* L.o (exp (- L.m m))) (* R.o (exp (- R.m m))))) -/
noncomputable def merge_a (L R : State_a V) : State_a V :=
  { m := max L.m R.m,
    d := L.d * Real.exp (L.m - max L.m R.m) + R.d * Real.exp (R.m - max L.m R.m),
    o := Real.exp (L.m - max L.m R.m) • L.o + Real.exp (R.m - max L.m R.m) • R.o }

/-- The candidate's output, every pass reading all of `X` as one block. -/
noncomputable def output (X : List (ℝ × V)) : Out V :=
  let a := block_a X
  { o := a.d⁻¹ • a.o }

/-- The candidate as a kernel runs it: every pass summarises the leaves of its own merge tree and merges the summaries along the tree. -/
noncomputable def blocked (t_a : Discovery.Tree (ℝ × V)) : Out V :=
  let a := t_a.eval block_a merge_a
  { o := a.d⁻¹ • a.o }

/-! ## The specification: `attention-3pass`, every pass reading all of `X` as one block -/

namespace Spec

/-- The state of pass `a`. -/
@[ext] structure State_a where
  m : ℝ

/-- Pass `a` on one block `A`: (m (rmax s)) -/
noncomputable def block_a (A : List (ℝ × V)) : State_a :=
  { m := lmax (A.map fun e => e.1) }

/-- The state of pass `b`. -/
@[ext] structure State_b where
  d : ℝ

/-- Pass `b` on one block `A`: (d (sum (exp (- s a.m)))) -/
noncomputable def block_b (a : State_a) (A : List (ℝ × V)) : State_b :=
  { d := (A.map fun e => Real.exp (e.1 - a.m)).sum }

/-- The state of pass `c`. -/
@[ext] structure State_c (V : Type*) where
  o : V

/-- Pass `c` on one block `A`: (o (sum (* (exp (- s a.m)) v))) -/
noncomputable def block_c (a : State_a) (A : List (ℝ × V)) : State_c V :=
  { o := (A.map fun e => Real.exp (e.1 - a.m) • e.2).sum }

/-- The specification's output. -/
noncomputable def output (X : List (ℝ × V)) : Out V :=
  let a := block_a X
  let b := block_b a X
  let c := block_c a X
  { o := b.d⁻¹ • c.o }

end Spec

/-! ## The statements, fixed before any proof text -/

def merge_block_a_statement : Prop :=
  ∀ (A B : List (ℝ × V)), A ≠ [] → B ≠ [] →
    merge_a (block_a A) (block_a B) = block_a (A ++ B)

def spec_eq_statement : Prop :=
  ∀ (X : List (ℝ × V)), X ≠ [] →
    output X = Spec.output X

def blocked_eq_spec_statement : Prop :=
  ∀ (X : List (ℝ × V)), X ≠ [] → ∀ (t_a : Discovery.Tree (ℝ × V)), t_a.flat = X → (∀ blk ∈ t_a.leaves, blk ≠ []) →
    blocked t_a = Spec.output X

/-! ## The proofs -/

-- helper lemmas
theorem sum_exp_shift_aux {V : Type*} (A : List (ℝ × V)) (c m : ℝ) :
    (A.map fun e => Real.exp (e.1 - c)).sum
      = (A.map fun e => Real.exp (e.1 - m)).sum * Real.exp (m - c) := by
  induction A with
  | nil => simp
  | cons y ys ih =>
    simp only [List.map_cons, List.sum_cons, ih]
    have h : Real.exp (y.1 - c) = Real.exp (y.1 - m) * Real.exp (m - c) := by
      rw [← Real.exp_add]; ring_nf
    rw [h]; ring

theorem vsum_exp_shift_aux {V : Type*} [AddCommGroup V] [Module ℝ V]
    (A : List (ℝ × V)) (c m : ℝ) :
    (A.map fun e => Real.exp (e.1 - c) • e.2).sum
      = Real.exp (m - c) • (A.map fun e => Real.exp (e.1 - m) • e.2).sum := by
  induction A with
  | nil => simp
  | cons y ys ih =>
    simp only [List.map_cons, List.sum_cons, ih]
    have h : Real.exp (y.1 - c) = Real.exp (m - c) * Real.exp (y.1 - m) := by
      rw [← Real.exp_add]; ring_nf
    rw [h, mul_smul, smul_add]

/-- Pass `a`: merging the summaries of two nonempty blocks gives the summary of the two blocks together. -/
theorem merge_block_a (A B : List (ℝ × V)) (hA : A ≠ []) (hB : B ≠ []) :
    merge_a (block_a A) (block_a B) = block_a (A ++ B) := by
  have hm := Discovery.lmax_map_append (fun e : ℝ × V => e.1) hA hB
  ext
  · simp only [merge_a, block_a]
    exact hm.symm
  · simp only [merge_a, block_a]
    rw [hm]
    simp only [List.map_append, List.sum_append]
    set M := max (Discovery.lmax (A.map fun e => e.1)) (Discovery.lmax (B.map fun e => e.1)) with hM
    have h1 := sum_exp_shift_aux A M (Discovery.lmax (A.map fun e => e.1))
    have h2 := sum_exp_shift_aux B M (Discovery.lmax (B.map fun e => e.1))
    rw [h1, h2]
    try ring
  · simp only [merge_a, block_a]
    rw [hm]
    simp only [List.map_append, List.sum_append]
    set M := max (Discovery.lmax (A.map fun e => e.1)) (Discovery.lmax (B.map fun e => e.1)) with hM
    have h1 := vsum_exp_shift_aux A M (Discovery.lmax (A.map fun e => e.1))
    have h2 := vsum_exp_shift_aux B M (Discovery.lmax (B.map fun e => e.1))
    rw [h1, h2]

/-- On one nonempty block, the candidate's output equals the specification's (`attention-3pass`). -/
theorem spec_eq (X : List (ℝ × V)) (hX : X ≠ []) :
    output X = Spec.output X := by
  first
    | rfl
    | simp only [output, Spec.output, block_a, Spec.block_a, Spec.block_b, Spec.block_c]

/-- Over any blocking and any merge trees, the candidate computes the specification: the framework theorem for every pass, then `spec_eq`. -/
theorem blocked_eq_spec (X : List (ℝ × V)) (hX : X ≠ []) (t_a : Discovery.Tree (ℝ × V)) (h_a : t_a.flat = X) (l_a : ∀ blk ∈ t_a.leaves, blk ≠ []) :
    blocked t_a = Spec.output X := by
  have e_0 : t_a.eval block_a merge_a = block_a X := by
    rw [Discovery.Tree.eval_eq_block merge_block_a t_a l_a, h_a]
  rw [← spec_eq X hX]
  simp only [blocked, output, e_0]

/-! ## Checks: every theorem against its statement fixed above, and its axioms -/

theorem merge_block_a_holds : merge_block_a_statement (V := V) := merge_block_a
theorem spec_eq_holds : spec_eq_statement (V := V) := spec_eq
theorem blocked_eq_spec_holds : blocked_eq_spec_statement (V := V) := blocked_eq_spec

#print axioms merge_block_a_holds
#print axioms spec_eq_holds
#print axioms blocked_eq_spec_holds

end Discovery.Library.AttentionOnline
