import Discovery.Blocked
import Mathlib.Algebra.BigOperators.Ring.List
import Mathlib.Algebra.Module.BigOperators
import Mathlib.Analysis.Complex.Exponential
import Mathlib.Analysis.Real.Sqrt
import Mathlib.Analysis.SpecialFunctions.Log.Basic
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Module
import Mathlib.Tactic.Positivity
import Mathlib.Tactic.Ring

/-!
# `softmax-lse` against `softmax-3pass`

Generated by `discovery/lean_export.py` from the program below (digest 7e75f7ea56184bd2).

```
(program softmax-lse
  (input x)
  (pass a
    (state s)
    (block (m (rmax x))
           (s (+ m (log (sum (exp (- x m)))))))
    (merge (m (max L.s R.s))
           (s (+ m (log (+ (exp (- L.s m)) (exp (- R.s m))))))))
  (output elementwise (exp (- x a.s))))
```
-/

namespace Discovery.Library.SoftmaxLse

/-! ## The candidate -/

/-- The state of pass `a`. -/
@[ext] structure State_a where
  s : ℝ

/-- Pass `a` on one block `A`: (m (rmax x)) (s (+ m (log (sum (exp (- x m)))))) -/
noncomputable def block_a (A : List ℝ) : State_a :=
  { s := lmax A + Real.log (A.map fun x => Real.exp (x - lmax A)).sum }

/-- Pass `a`, two adjacent summaries `L` then `R` into one: (m (max L.s R.s)) (s (+ m (log (+ (exp (- L.s m)) (exp (- R.s m)))))) -/
noncomputable def merge_a (L R : State_a) : State_a :=
  { s := max L.s R.s + Real.log (Real.exp (L.s - max L.s R.s) + Real.exp (R.s - max L.s R.s)) }

/-- The candidate's output, every pass reading all of `X` as one block. -/
noncomputable def output (X : List ℝ) (x : ℝ) : ℝ :=
  let a := block_a X
  Real.exp (x - a.s)

/-- The candidate as a kernel runs it: every pass summarises the leaves of its own merge tree and merges the summaries along the tree. -/
noncomputable def blocked (t_a : Discovery.Tree ℝ) (x : ℝ) : ℝ :=
  let a := t_a.eval block_a merge_a
  Real.exp (x - a.s)

/-! ## The specification: `softmax-3pass`, every pass reading all of `X` as one block -/

namespace Spec

/-- The state of pass `a`. -/
@[ext] structure State_a where
  m : ℝ

/-- Pass `a` on one block `A`: (m (rmax x)) -/
noncomputable def block_a (A : List ℝ) : State_a :=
  { m := lmax A }

/-- The state of pass `b`. -/
@[ext] structure State_b where
  d : ℝ

/-- Pass `b` on one block `A`: (d (sum (exp (- x a.m)))) -/
noncomputable def block_b (a : State_a) (A : List ℝ) : State_b :=
  { d := (A.map fun x => Real.exp (x - a.m)).sum }

/-- The specification's output. -/
noncomputable def output (X : List ℝ) (x : ℝ) : ℝ :=
  let a := block_a X
  let b := block_b a X
  Real.exp (x - a.m) / b.d

end Spec

/-! ## The statements, fixed before any proof text -/

def merge_block_a_statement : Prop :=
  ∀ (A B : List ℝ), A ≠ [] → B ≠ [] →
    merge_a (block_a A) (block_a B) = block_a (A ++ B)

def spec_eq_statement : Prop :=
  ∀ (X : List ℝ), X ≠ [] → ∀ (x : ℝ),
    output X x = Spec.output X x

def blocked_eq_spec_statement : Prop :=
  ∀ (X : List ℝ), X ≠ [] → ∀ (t_a : Discovery.Tree ℝ), t_a.flat = X → (∀ blk ∈ t_a.leaves, blk ≠ []) → ∀ (x : ℝ),
    blocked t_a x = Spec.output X x

/-! ## The proofs -/

-- helper lemmas
theorem sm_sum_exp_pos (A : List ℝ) (hA : A ≠ []) (c : ℝ) :
    0 < (A.map fun x => Real.exp (x - c)).sum := by
  cases A with
  | nil => exact absurd rfl hA
  | cons y ys =>
    simp only [List.map_cons, List.sum_cons]
    have h0 : 0 ≤ (ys.map fun x => Real.exp (x - c)).sum := by
      apply List.sum_nonneg
      intro z hz
      simp only [List.mem_map] at hz
      obtain ⟨w, _, rfl⟩ := hz
      exact (Real.exp_pos _).le
    have := Real.exp_pos (y - c)
    linarith

theorem sm_scale (A : List ℝ) (c m : ℝ) :
    (A.map fun x => Real.exp (x - c)).sum
      = Real.exp (m - c) * (A.map fun x => Real.exp (x - m)).sum := by
  induction A with
  | nil => simp
  | cons y ys ih =>
    simp only [List.map_cons, List.sum_cons, ih]
    have e : Real.exp (y - c) = Real.exp (m - c) * Real.exp (y - m) := by
      rw [← Real.exp_add]
      congr 1
      ring
    rw [e]
    ring

theorem sm_pos0 (A : List ℝ) (hA : A ≠ []) :
    0 < (A.map fun x => Real.exp x).sum := by
  have := sm_sum_exp_pos A hA 0
  simpa only [sub_zero] using this

theorem sm_block_s (A : List ℝ) (hA : A ≠ []) :
    (block_a A).s = Real.log (A.map fun x => Real.exp x).sum := by
  have h := sm_scale A 0 (lmax A)
  have h2 : (A.map fun x => Real.exp x).sum
      = Real.exp (lmax A) * (A.map fun x => Real.exp (x - lmax A)).sum := by
    simp only [sub_zero] at h
    exact h
  have hp := sm_sum_exp_pos A hA (lmax A)
  rw [h2, Real.log_mul (Real.exp_ne_zero _) hp.ne', Real.log_exp]
  rfl

theorem sm_max_log (u v : ℝ) :
    max u v + Real.log (Real.exp (u - max u v) + Real.exp (v - max u v))
      = Real.log (Real.exp u + Real.exp v) := by
  have h : Real.exp (u - max u v) + Real.exp (v - max u v)
      = (Real.exp u + Real.exp v) * Real.exp (-(max u v)) := by
    rw [Real.exp_sub, Real.exp_sub, Real.exp_neg]
    ring
  have hne : Real.exp u + Real.exp v ≠ 0 := by positivity
  rw [h, Real.log_mul hne (Real.exp_ne_zero _), Real.log_exp]
  ring

/-- Pass `a`: merging the summaries of two nonempty blocks gives the summary of the two blocks together. -/
theorem merge_block_a (A B : List ℝ) (hA : A ≠ []) (hB : B ≠ []) :
    merge_a (block_a A) (block_a B) = block_a (A ++ B) := by
  have hAB : A ++ B ≠ [] := by
    intro h
    exact hA (List.append_eq_nil_iff.mp h).1
  ext
  simp only [merge_a]
  rw [sm_max_log, sm_block_s A hA, sm_block_s B hB, sm_block_s (A ++ B) hAB,
    Real.exp_log (sm_pos0 A hA), Real.exp_log (sm_pos0 B hB), List.map_append,
    List.sum_append]

/-- On one nonempty block, the candidate's output equals the specification's (`softmax-3pass`), for every element value. -/
theorem spec_eq (X : List ℝ) (hX : X ≠ []) (x : ℝ) :
    output X x = Spec.output X x := by
  have hp := sm_sum_exp_pos X hX (lmax X)
  have key : ∀ m S : ℝ, 0 < S →
      Real.exp (x - (m + Real.log S)) = Real.exp (x - m) / S := by
    intro m S h
    rw [← sub_sub, Real.exp_sub, Real.exp_log h]
  simp only [output, Spec.output, block_a, Spec.block_a, Spec.block_b]
  exact key _ _ hp

/-- Over any blocking and any merge trees, the candidate computes the specification: the framework theorem for every pass, then `spec_eq`. -/
theorem blocked_eq_spec (X : List ℝ) (hX : X ≠ []) (t_a : Discovery.Tree ℝ) (h_a : t_a.flat = X) (l_a : ∀ blk ∈ t_a.leaves, blk ≠ []) (x : ℝ) :
    blocked t_a x = Spec.output X x := by
  have e_0 : t_a.eval block_a merge_a = block_a X := by
    rw [Discovery.Tree.eval_eq_block merge_block_a t_a l_a, h_a]
  rw [← spec_eq X hX x]
  simp only [blocked, output, e_0]

/-! ## Checks: every theorem against its statement fixed above, and its axioms -/

theorem merge_block_a_holds : merge_block_a_statement := merge_block_a
theorem spec_eq_holds : spec_eq_statement := spec_eq
theorem blocked_eq_spec_holds : blocked_eq_spec_statement := blocked_eq_spec

#print axioms merge_block_a_holds
#print axioms spec_eq_holds
#print axioms blocked_eq_spec_holds

end Discovery.Library.SoftmaxLse
