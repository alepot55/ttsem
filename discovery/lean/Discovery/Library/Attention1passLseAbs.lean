/-!
# `attention-1pass-lse-abs` against `attention-3pass`

Generated by `discovery/lean_export.py` from the program below (digest 0a4f90885f45207c).

```
(program attention-1pass-lse-abs
  (input s v)
  (pass a
    (state a u)
    (block (m (rmax s))
           (a (+ m (log (sum (exp (- s m))))))
           (u (sum (* (exp (- s a)) v))))
    (merge (a (+ (max L.a R.a) (log (+ 1 (exp (neg (abs (- L.a R.a))))))))
           (u (+ (* L.u (exp (- L.a a))) (* R.u (exp (- R.a a)))))))
  (output final (o a.u)))
```
-/

namespace Discovery.Library.Attention1passLseAbs

variable {V : Type*} [AddCommGroup V] [Module ℝ V]

/-- The named outputs. -/
@[ext] structure Out (V : Type*) where
  o : V

/-! ## The candidate -/

/-- The state of pass `a`. -/
@[ext] structure State_a (V : Type*) where
  a : ℝ
  u : V

/-- Pass `a` on one block `A`: (m (rmax s)) (a (+ m (log (sum (exp (- s m)))))) (u (sum (* (exp (- s a)) v))) -/
noncomputable def block_a (A : List (ℝ × V)) : State_a V :=
  { a := lmax (A.map fun e => e.1) + Real.log (A.map fun e => Real.exp (e.1 - lmax (A.map fun e => e.1))).sum,
    u := (A.map fun e => Real.exp (e.1 - (lmax (A.map fun e => e.1) + Real.log (A.map fun e => Real.exp (e.1 - lmax (A.map fun e => e.1))).sum)) • e.2).sum }

/-- Pass `a`, two adjacent summaries `L` then `R` into one: (a (+ (max L.a R.a) (log (+ 1 (exp (neg (abs (- L.a R.a)))))))) (u (+ (* L.u (exp (- L.a a))) (* R.u (exp (- R.a a))))) -/
noncomputable def merge_a (L R : State_a V) : State_a V :=
  { a := max L.a R.a + Real.log ((1 : ℝ) + Real.exp (-|L.a - R.a|)),
    u := Real.exp (L.a - (max L.a R.a + Real.log ((1 : ℝ) + Real.exp (-|L.a - R.a|)))) • L.u + Real.exp (R.a - (max L.a R.a + Real.log ((1 : ℝ) + Real.exp (-|L.a - R.a|)))) • R.u }

/-- The candidate's output, every pass reading all of `X` as one block. -/
noncomputable def output (X : List (ℝ × V)) : Out V :=
  let a := block_a X
  { o := a.u }

/-- The candidate as a kernel runs it: every pass summarises the leaves of its own merge tree and merges the summaries along the tree. -/
noncomputable def blocked (t_a : Discovery.Tree (ℝ × V)) : Out V :=
  let a := t_a.eval block_a merge_a
  { o := a.u }

/-! ## The specification: `attention-3pass`, every pass reading all of `X` as one block -/

namespace Spec

/-- The state of pass `a`. -/
@[ext] structure State_a where
  m : ℝ

/-- Pass `a` on one block `A`: (m (rmax s)) -/
noncomputable def block_a (A : List (ℝ × V)) : State_a :=
  { m := lmax (A.map fun e => e.1) }

/-- The state of pass `b`. -/
@[ext] structure State_b where
  d : ℝ

/-- Pass `b` on one block `A`: (d (sum (exp (- s a.m)))) -/
noncomputable def block_b (a : State_a) (A : List (ℝ × V)) : State_b :=
  { d := (A.map fun e => Real.exp (e.1 - a.m)).sum }

/-- The state of pass `c`. -/
@[ext] structure State_c (V : Type*) where
  o : V

/-- Pass `c` on one block `A`: (o (sum (* (exp (- s a.m)) v))) -/
noncomputable def block_c (a : State_a) (A : List (ℝ × V)) : State_c V :=
  { o := (A.map fun e => Real.exp (e.1 - a.m) • e.2).sum }

/-- The specification's output. -/
noncomputable def output (X : List (ℝ × V)) : Out V :=
  let a := block_a X
  let b := block_b a X
  let c := block_c a X
  { o := b.d⁻¹ • c.o }

end Spec

/-! ## The statements, fixed before any proof text -/

def merge_block_a_statement : Prop :=
  ∀ (A B : List (ℝ × V)), A ≠ [] → B ≠ [] →
    merge_a (block_a A) (block_a B) = block_a (A ++ B)

def spec_eq_statement : Prop :=
  ∀ (X : List (ℝ × V)), X ≠ [] →
    output X = Spec.output X

def blocked_eq_spec_statement : Prop :=
  ∀ (X : List (ℝ × V)), X ≠ [] → ∀ (t_a : Discovery.Tree (ℝ × V)), t_a.flat = X → (∀ blk ∈ t_a.leaves, blk ≠ []) →
    blocked t_a = Spec.output X

/-! ## The proofs -/

-- helper lemmas
theorem sum_shift (c d : ℝ) (X : List (ℝ × V)) :
    (X.map fun e => Real.exp (e.1 - c) • e.2).sum
      = Real.exp (d - c) • (X.map fun e => Real.exp (e.1 - d) • e.2).sum := by
  induction X with
  | nil => simp
  | cons y ys ih =>
    have h : Real.exp (y.1 - c) = Real.exp (d - c) * Real.exp (y.1 - d) := by
      rw [← Real.exp_add]; congr 1; ring
    simp only [List.map_cons, List.sum_cons, ih]
    rw [h]
    module

theorem spec_core (m S : ℝ) (hS : 0 < S) (X : List (ℝ × V)) :
    (X.map fun e => Real.exp (e.1 - (m + Real.log S)) • e.2).sum
      = S⁻¹ • (X.map fun e => Real.exp (e.1 - m) • e.2).sum := by
  have h : Real.exp (m - (m + Real.log S)) = S⁻¹ := by
    rw [show m - (m + Real.log S) = -Real.log S by ring, Real.exp_neg, Real.exp_log hS]
  rw [sum_shift (m + Real.log S) m X, h]

theorem sum_exp_pos' (f : ℝ × V → ℝ) (X : List (ℝ × V)) (hX : X ≠ []) :
    0 < (X.map fun e => Real.exp (f e)).sum := by
  induction X with
  | nil => exact absurd rfl hX
  | cons y ys ih =>
    rw [List.map_cons, List.sum_cons]
    by_cases h : ys = []
    · subst h
      simpa using Real.exp_pos (f y)
    · have h1 := ih h
      have h2 := Real.exp_pos (f y)
      linarith

theorem sum_exp_shift (m : ℝ) (X : List (ℝ × V)) :
    (X.map fun e => Real.exp e.1).sum
      = Real.exp m * (X.map fun e => Real.exp (e.1 - m)).sum := by
  induction X with
  | nil => simp
  | cons y ys ih =>
    have h : Real.exp y.1 = Real.exp m * Real.exp (y.1 - m) := by
      rw [← Real.exp_add]; congr 1; ring
    simp only [List.map_cons, List.sum_cons, ih]
    rw [h]
    ring

theorem ba_a (A : List (ℝ × V)) :
    (block_a A).a = lmax (A.map fun e => e.1)
      + Real.log (A.map fun e => Real.exp (e.1 - lmax (A.map fun e => e.1))).sum := rfl

theorem ba_u (A : List (ℝ × V)) :
    (block_a A).u = (A.map fun e => Real.exp (e.1 - (block_a A).a) • e.2).sum := rfl

theorem ba_exp (A : List (ℝ × V)) (hA : A ≠ []) :
    Real.exp (block_a A).a = (A.map fun e => Real.exp e.1).sum := by
  have hS : 0 < (A.map fun e => Real.exp (e.1 - lmax (A.map fun e => e.1))).sum :=
    sum_exp_pos' (fun e => e.1 - lmax (A.map fun e => e.1)) A hA
  rw [ba_a, Real.exp_add, Real.exp_log hS, sum_exp_shift (lmax (A.map fun e => e.1)) A]

theorem ba_log (A : List (ℝ × V)) (hA : A ≠ []) :
    (block_a A).a = Real.log (A.map fun e => Real.exp e.1).sum := by
  rw [← ba_exp A hA, Real.log_exp]

theorem merge_lse (x y : ℝ) :
    max x y + Real.log ((1 : ℝ) + Real.exp (-|x - y|)) = Real.log (Real.exp x + Real.exp y) := by
  have h : Real.exp (max x y + Real.log ((1 : ℝ) + Real.exp (-|x - y|))) = Real.exp x + Real.exp y := by
    rw [Real.exp_add, Real.exp_log (by positivity)]
    rcases le_total x y with h | h
    · have habs : |x - y| = y - x := by
        rw [abs_of_nonpos (by linarith)]; ring
      have e : Real.exp y * Real.exp (-(y - x)) = Real.exp x := by
        rw [← Real.exp_add]; congr 1; ring
      rw [max_eq_right h, habs]
      linear_combination e
    · have habs : |x - y| = x - y := abs_of_nonneg (by linarith)
      have e : Real.exp x * Real.exp (-(x - y)) = Real.exp y := by
        rw [← Real.exp_add]; congr 1; ring
      rw [max_eq_left h, habs]
      linear_combination e
  rw [← h, Real.log_exp]

/-- Pass `a`: merging the summaries of two nonempty blocks gives the summary of the two blocks together. -/
theorem merge_block_a (A B : List (ℝ × V)) (hA : A ≠ []) (hB : B ≠ []) :
    merge_a (block_a A) (block_a B) = block_a (A ++ B) := by
  have hAB : A ++ B ≠ [] := by simp [hA]
  have key : (block_a (A ++ B)).a = Real.log ((A.map fun e => Real.exp e.1).sum + (B.map fun e => Real.exp e.1).sum) := by
    rw [← List.sum_append, ← List.map_append]
    exact ba_log (A ++ B) hAB
  have ha : (merge_a (block_a A) (block_a B)).a = (block_a (A ++ B)).a := by
    rw [key]
    show max (block_a A).a (block_a B).a + Real.log ((1:ℝ) + Real.exp (-|(block_a A).a - (block_a B).a|)) = _
    rw [merge_lse, ba_exp A hA, ba_exp B hB]
  refine State_a.ext ha ?_
  show Real.exp ((block_a A).a - (merge_a (block_a A) (block_a B)).a) • (block_a A).u + Real.exp ((block_a B).a - (merge_a (block_a A) (block_a B)).a) • (block_a B).u = _
  rw [ha, ba_u (A ++ B), List.map_append, List.sum_append, sum_shift _ ((block_a A).a) A, sum_shift _ ((block_a B).a) B, ba_u A, ba_u B]

/-- On one nonempty block, the candidate's output equals the specification's (`attention-3pass`). -/
theorem spec_eq (X : List (ℝ × V)) (hX : X ≠ []) :
    output X = Spec.output X := by
  refine Out.ext ?_
  have hS : 0 < (X.map fun e => Real.exp (e.1 - lmax (X.map fun e => e.1))).sum :=
    sum_exp_pos' (fun e => e.1 - lmax (X.map fun e => e.1)) X hX
  simp only [output, Spec.output, block_a, Spec.block_a, Spec.block_b, Spec.block_c]
  exact spec_core _ _ hS X

/-- Over any blocking and any merge trees, the candidate computes the specification: the framework theorem for every pass, then `spec_eq`. -/
theorem blocked_eq_spec (X : List (ℝ × V)) (hX : X ≠ []) (t_a : Discovery.Tree (ℝ × V)) (h_a : t_a.flat = X) (l_a : ∀ blk ∈ t_a.leaves, blk ≠ []) :
    blocked t_a = Spec.output X := by
  have e_0 : t_a.eval block_a merge_a = block_a X := by
    rw [Discovery.Tree.eval_eq_block merge_block_a t_a l_a, h_a]
  rw [← spec_eq X hX]
  simp only [blocked, output, e_0]

/-! ## Checks: every theorem against its statement fixed above, and its axioms -/

theorem merge_block_a_holds : merge_block_a_statement (V := V) := merge_block_a
theorem spec_eq_holds : spec_eq_statement (V := V) := spec_eq
theorem blocked_eq_spec_holds : blocked_eq_spec_statement (V := V) := blocked_eq_spec

#print axioms merge_block_a_holds
#print axioms spec_eq_holds
#print axioms blocked_eq_spec_holds

end Discovery.Library.Attention1passLseAbs
